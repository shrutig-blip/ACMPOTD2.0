#Beginner: Translation- check length of both strings, if differ, then NO,
otherwise, check run a loop, to match s and t characters in opposite directions.

#include <iostream>
#include <string>
using namespace std;
int main(){
    string s;
    cin>>s;
    string t;
    cin>>t;
    if(s.length()!=t.length()){
        cout<<"NO";
        return 0;
    }
    int n=t.length()-1;
    for(char ch:s){
        if (ch!=t[n]){
            cout<<"NO";
            return 0;
        }
        n--;
    }
    cout<<"YES";
    return 0;
}


#Intermediate: Greed-- sum the quantities that need to be added in 2 cans. , 
find largest and slargest from capacities array while taking input of values, 
then later check if sum<=(largest+slargest), then YES, otherwise NO. (as we need to fill the remaining quantity in any 2 cans, so we find the largest ones..)

#include <iostream>
using namespace std;

int main(){
    int n;
    cin>> n;
    long long vol=0;
    int v=0;
    for(int i=0;i<n;i++){
        cin>>v;
        vol+=v;
    }
    int arr[n];
    int largest=0;
    int slargest=0;
    
    for(int i=0;i<n;i++){
        long long x;
        cin>>x;
        
        if(x>largest){
            slargest=largest;
            largest=x;
        }
        else if(x>slargest){
            slargest=x;
        }
    }
    
    if(largest+slargest >=vol){
        cout<<"YES";
        return 0;
    }
    cout<<"NO";
    return 0;
}
