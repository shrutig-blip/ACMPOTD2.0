}

#Intermediate: Theatre Square--> found minimum no. of squares of side a, will be required to cover length n, and similarly for length m, and multiplied them to obtain the answer, 
(basically ceiling operation , but nor directly, by using elaborated calculations)--> can also be done directly in 2 lines(as mentioned below)
TC=O(1), SC=O(1)


#include <iostream>
using namespace std;

int main(){
    int n,m;
    cin>>n>>m;
    long long a;
    cin>>a;
    
    long long n_ans=0;
    long long nleft=n;
    if(nleft>0 && nleft>=a){
        n_ans+=(nleft/a);
        nleft-=((nleft/a)*a);
    }
    if(nleft>0 && nleft<a) n_ans++; 
    
    long long m_ans=0;
    long long mleft=m;
    if(mleft>0 && mleft>=a){
        m_ans+=(mleft/a);
        mleft-=((mleft/a)*a);
    }
    if(mleft>0 && mleft<a) m_ans++;
    long long ans=n_ans*m_ans;
    cout<<ans;
    return 0;
}


