#Beginner: Reconnaissance 2 : keep diff variable and track difference between two consecutive elements throughout the array 
and update mini whenever required, also do the same for the pari of 1st and last element of arr and print indices.

#include <iostream>
#include <cstdlib>
using namespace std;

int main(){
    int n;
    cin>> n;
    int arr[n];
    for(int i=0;i<n;i++){
        cin>> arr[i];
    }
    
    int mini=1000000;
    int first=-1;
    int second=-1;
    
    for(int i=0;i<n-1;i++){
        int diff=abs(arr[i]-arr[i+1]);
        if(diff<mini){
            second=i+1;
            mini=diff;
            first=i;
        }
        
    }
    int diff=abs(arr[n-1]-arr[0]);
    if(diff<mini){
        first=n-1;
        second=0;
    }
    cout<< first+1 <<" "<<second+1;
    return 0;
}




#Intermediate: Quasi-Palindrome

1st approach: convert num to strong, avoid leading and trailing zeroes and then check palindrome with 2 pointers.

#include <iostream>
#include <string>
using namespace std;
int main(){
    int num;
    cin>> num;
    string s=to_string(num);
    
    int i=0;
    int j=s.size()-1;
    int nz1=0;
    int nz2=0;
    while(i<=j){
        if(s[i]=='0' && nz1==0) i++;
        else if(s[j]=='0' && nz2==0) j--;
        else if(s[i]!='0' && nz1==0) nz1=1;
        else if(s[j]!='0' && nz2==0) nz2=1;
        else if(s[i]!=s[j]){
            cout<<"NO";
            return 0;
        }
        else{
            i++;
            j--;
        }
        
        
    }
    cout<<"YES";
    return 0;
    
}

2nd approach: pop out all the trailing zeros at the back from the string and then simply check for palindrome.

#include <iostream>
#include <string>
using namespace std;
int main(){
    int num;
    cin>> num;
    string s=to_string(num);
    while(s.back()=='0') s.pop_back();
    int i=0;
    int j=s.size()-1;
    while(i<=j){
        if(s[i]!=s[j]){
            cout<<"NO";
            return 0;
        }
        i++;
        j--;
    }
    cout<<"YES";
    return 0;
    
}


