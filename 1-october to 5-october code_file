#Borze- used simple if else loop while iterating throughout the string, 

#include <iostream>
#include <string>
using namespace std;

int main(){
    string s;
    cin>>s;
    for(int i=0;i<s.length();i++){
        if(s[i]=='.') cout<<"0";
        else{
            if(s[i+1]=='.') cout<<"1";
            else cout<<"2";
            i++;
        }
    }
    return 0;
}

#Lucky Year:

#integer approach-> find length of input a, find 1st digit of a, multiply it by 10 by (length of a-1) times,and call it b, then return b-a;

#include <iostream>
using namespace std;

int main(){
    int a;
    cin>>a;
    int temp=a;
    int power=1;
    while(temp>=10){
        temp/=10;
        power*=10;
    }
    int b=(temp+1)* power;
    cout<<b-a;
    return 0;
    
}


