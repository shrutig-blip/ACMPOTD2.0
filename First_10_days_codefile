#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;

int main(){
    int n,m;
    cin>>n>>m;
    vector<string> matrix(n);
    for(int i=0;i<n;i++){
            cin>>matrix[i];
    }
    int minrow=n;
    int maxrow=-1;
    int mincol=m;
    int maxcol=-1;
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            if(matrix[i][j]=='*'){
                minrow=min(minrow,i);
                maxrow=max(maxrow,i);
                mincol=min(mincol,j);
                maxcol=max(maxcol,j);
            }
        }
    }
    for(int i=minrow;i<=maxrow;i++){
        for(int j=mincol;j<=maxcol;j++){
            cout<<matrix[i][j];
        }
        cout<<endl;
    }
    return 0;
}







